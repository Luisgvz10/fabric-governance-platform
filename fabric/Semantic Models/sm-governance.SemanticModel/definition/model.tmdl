model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - lh_metadata"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","TMDLView_Desktop"]

ref table fact_item_access
ref table fact_activity
ref table dim_inventory
ref table fact_workspace_access
ref table dim_user
ref table fact_lineage
ref table dim_tenant_setting
ref table dim_workspace
ref table fact_capacity_metrics
ref table _Measures
ref table dim_date

