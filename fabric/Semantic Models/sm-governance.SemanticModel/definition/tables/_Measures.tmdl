table _Measures
	lineageTag: a1b2c3d4-0001-4000-8000-000000000001

	measure 'Total Activities' = COUNTROWS(fact_activity)
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000002

	measure 'Background CU %' = SUM(fact_capacity_metrics[background_pct])
		formatString: 0.0
		lineageTag: a1b2c3d4-0001-4000-8000-00000000000c

	measure 'Interactive CU %' = SUM(fact_capacity_metrics[interactive_pct])
		formatString: 0.0
		lineageTag: a1b2c3d4-0001-4000-8000-00000000000d

	measure 'Hours Over 100% CU' =
			CALCULATE(
			    COUNTROWS(fact_capacity_metrics),
			    fact_capacity_metrics[background_pct] > 100
			)
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-00000000000e

	measure 'Total Workspaces' = COUNTROWS(dim_workspace)
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000011

	measure 'Total Capacities' = DISTINCTCOUNT(dim_workspace[capacity_id])
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000012

	measure 'Total Users' =
			CALCULATE(
			    COUNTROWS(dim_user),
			    dim_user[principal_type] = "User"
			)
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000014

	measure 'Total Items' = COUNTROWS(dim_inventory)
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-00000000000f

	measure 'Total Security Groups' =
			CALCULATE(
			    COUNTROWS(dim_user),
			    dim_user[principal_type] = "Group"
			)
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000015

	measure 'Total Service Principals' =
			CALCULATE(
			    COUNTROWS(dim_user),
			    dim_user[principal_type] = "Service"
			)
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000016

	measure 'Total Failed Activities' =
			CALCULATE(
			    COUNTROWS(fact_activity),
			    fact_activity[is_success] = FALSE
			)
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000017

	measure '% Failed Activities' =
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_activity), fact_activity[is_success] = FALSE),
			    COUNTROWS(fact_activity)
			)
		formatString: 0.0%
		lineageTag: a1b2c3d4-0001-4000-8000-000000000018

	partition _Measures = calculated
		mode: import
		source = "Measures"

